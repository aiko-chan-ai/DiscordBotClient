{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["vite/client"]
    },
    "include": ["src/Renderer/**/*.ts", "src/Renderer/**/*.tsx", "src/shared/**/*.ts"]
}
